    "options": {
        "step": {
            "init": {
                "title": "Jackery Optionen",
                "description": "Verbindung, optionales SmartMeter-HTTP-Polling und Entwicklerdiagnose konfigurieren. Experimentelle MQTT-Rohmitschnitte können vertrauliche Informationen enthalten; Diagnosedaten vor dem Teilen sorgfältig prüfen.",
                "data": {
                    "token": "Token",
                    "topic_prefix": "MQTT-Topic-Präfix",
                    "smartmeter_http_poll": "SmartMeter per HTTP abfragen (Spannung, Strom, Blindleistung, …)",
                    "smartmeter_poll_interval": "SmartMeter-Abfrageintervall (Sekunden)",
                    "protocol_discovery_enabled": "Experimentelle Protokollerkennung mit persistenter Aufzeichnung relevanter unbekannter MQTT-Nachrichten",
                    "alert_capture_enabled": "Experimentelle MQTT-Alert-Aufzeichnung",
                    "bmslog_capture_enabled": "Experimentellen BMS-Log-Mitschnitt aktivieren"
                },
                "data_description": {
                    "protocol_discovery_enabled": "Zeichnet begrenzte Strukturbeobachtungen und ausgewählte MQTT-Rohpayloads dauerhaft auf. Rohdaten können vertrauliche Informationen enthalten. Diagnosedaten vor dem Teilen sorgfältig prüfen.",
                    "alert_capture_enabled": "Zeichnet unbekannte MQTT-Alert-Nachrichten passiv und lokal als begrenzte Rohdaten auf. Die Daten können vertrauliche Informationen enthalten und sind vor dem Teilen zu prüfen. Nur für Entwickler und Tester empfohlen.",
                    "bmslog_capture_enabled": "Zeichnet passiv ausschließlich das exakte /bmslog-Topic des konfigurierten Geräts als begrenzte Rohdaten auf. Payloads können vertrauliche Informationen enthalten und sind vor dem Teilen zu prüfen. Standardmäßig deaktiviert."
                }
            }
        }
